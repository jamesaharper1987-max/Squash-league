const RIVALRY_JM = '🏆 James v Mic (The Main Event)';
const RIVALRY_JL = '🥉 Jigs v Lah (The Lower Leagues)';

function setup() {
  // ---- Sheet ----
  const ss = SpreadsheetApp.create('Squash League HQ: Results');
  const hist = ss.getSheets()[0].setName('History');
  const header = ['Rivalry', 'Date', 'James', 'Mic', 'Jigs', 'Lah', 'Asterisk', 'Notes', 'Day', 'Time slot'];
  const rows = HISTORY.map(r => [
    r[0] === 'jm' ? RIVALRY_JM : RIVALRY_JL,
    r[1] || '', r[2], r[3], r[4], r[5], r[6] ? 'Yes' : '', r[7] || '', r[8] || '', r[9] || ''
  ]);
  hist.getRange(1, 1, rows.length + 1, header.length).setNumberFormat('@'); // keep everything as plain text
  hist.getRange(1, 1, 1, header.length).setValues([header]).setFontWeight('bold');
  hist.getRange(2, 1, rows.length, header.length).setValues(rows.map(r => r.map(v => v === '' || v === null ? '' : String(v))));
  hist.setFrozenRows(1);
  hist.autoResizeColumns(1, 7);

  // ---- Form ----
  const form = FormApp.create('Report a Squash Result');
  form.setDescription(
    'Official results desk of Squash League HQ.\n' +
    'One submission = one match (Jigs v Lah) or one session (James v Mic).\n' +
    'Lying on this form is a stroke against you. Probably.'
  );
  form.setConfirmationMessage('Result logged. The Golden Headband Commicee thanks you for your service. 🎾');
  form.setCollectEmail(false);
  form.setAllowResponseEdits(false);
  form.setShowLinkToRespondAgain(true);

  form.addListItem().setTitle("Who's reporting?")
      .setChoiceValues(['James', 'Mic', 'Jack (Jigs)', 'Kevin (Lah)']).setRequired(true);
  form.addDateItem().setTitle('Date played').setRequired(true);
  const rivalry = form.addMultipleChoiceItem().setTitle('Which rivalry?').setRequired(true);

  const nums = n => Array.from({length: n + 1}, (_, i) => String(i));

  const pJM = form.addPageBreakItem().setTitle('James v Mic: The Main Event')
      .setHelpText('Total games won by each of you in the session.');
  form.addListItem().setTitle('James: games won').setChoiceValues(nums(20)).setRequired(true);
  form.addListItem().setTitle('Mic: games won').setChoiceValues(nums(20)).setRequired(true);
  form.addParagraphTextItem().setTitle('James v Mic notes')
      .setHelpText('Excuses, controversies, lets that should have been strokes, etc.');

  const pJL = form.addPageBreakItem().setTitle('Jigs v Lah: The Lower Leagues')
      .setHelpText('One match, best of five. If you stopped early, just enter the games as they stood.');
  form.addListItem().setTitle('Jigs: games won').setChoiceValues(nums(3)).setRequired(true);
  form.addListItem().setTitle('Lah: games won').setChoiceValues(nums(3)).setRequired(true);
  form.addMultipleChoiceItem().setTitle('Asterisk?')
      .setChoiceValues(['No, clean result', 'Yes, asterisk it (ill / hungover / broken / cold / BBC deadline)'])
      .setRequired(true);
  form.addParagraphTextItem().setTitle('Jigs v Lah notes')
      .setHelpText('The dressing-room gossip. Be as petty as you like.');

  rivalry.setChoices([
    rivalry.createChoice(RIVALRY_JM, pJM),
    rivalry.createChoice(RIVALRY_JL, pJL),
  ]);
  pJM.setGoToPage(FormApp.PageNavigationType.SUBMIT); // James v Mic section ends the form

  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());

  // Rename the linked responses tab to "Responses" (its default name depends on your language)
  SpreadsheetApp.flush();
  Utilities.sleep(3000);
  const fresh = SpreadsheetApp.openById(ss.getId());
  const respSheet = fresh.getSheets().find(s => s.getFormUrl());
  if (respSheet) respSheet.setName('Responses');

  // ---- Sharing: anyone with the link can VIEW (needed for the website to read it) ----
  let sharingNote = 'Sheet shared: anyone with the link can view ✅';
  try {
    DriveApp.getFileById(ss.getId()).setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  } catch (e) {
    sharingNote = '⚠️ Could not set link sharing automatically (' + e + '). Open the Sheet → Share → General access → "Anyone with the link" → Viewer.';
  }

  let shortUrl = form.getPublishedUrl();
  try { shortUrl = form.shortenFormUrl(shortUrl); } catch (e) {}

  Logger.log('================ COPY THESE INTO config.js ================');
  Logger.log('SHEET_ID:  ' + ss.getId());
  Logger.log('FORM_URL:  ' + shortUrl);
  Logger.log('===========================================================');
  Logger.log('Sheet (for you to fix mistakes): ' + ss.getUrl());
  Logger.log('Form editor: ' + form.getEditUrl());
  Logger.log(sharingNote);
  Logger.log('Responses tab found: ' + (respSheet ? 'yes' : 'NO: rename the form responses tab to "Responses" by hand'));
}
